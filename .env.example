# pnpm env:init generates a private .env with random, local-only credentials.
DRIVEM_ENV=development
# Compose settings for the one local PostgreSQL instance and local Auth.
LOCAL_POSTGRES_PORT=54322
LOCAL_REDIS_PORT=16379
LOCAL_AUTH_PORT=54321
POSTGRES_PASSWORD=
WEB_DB_PASSWORD=
WORKER_DB_PASSWORD=
GOTRUE_DB_PASSWORD=
GOTRUE_JWT_SECRET=
# Used by the local migration/bootstrap scripts only.
DATABASE_MIGRATION_URL=
# Restricted PostgreSQL login for each runtime.
DATABASE_WEB_URL=
DATABASE_WORKER_URL=
# BullMQ and health probe (local Redis binds to loopback).
REDIS_URL=redis://127.0.0.1:16379
WORKER_HEALTH_PORT=3101
# Server-side Supabase URL and anon/publishable key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Local admin provisioning only. Keep out of deployment runtime.
SUPABASE_SERVICE_ROLE_KEY=
